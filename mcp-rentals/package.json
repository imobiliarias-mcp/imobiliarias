{
  "name": "mcp-rentals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "test:browser": "tsx --test tests/ui/bundle-host.browser.ts",
    "check": "tsc --noEmit",
    "build": "tsx scripts/export-contracts.ts && vite build && tsc -p tsconfig.server.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/server/src/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
